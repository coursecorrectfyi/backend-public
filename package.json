{
  "name": "backend",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.test.json",
    "embed": "tsx src/jobs/embed.ts",
    "embed:dry": "DRY_RUN_LIMIT=20 tsx src/jobs/embed.ts",
    "onet:seed": "tsx src/jobs/onet/seed.ts",
    "insights:dry": "tsx src/jobs/insights/dry-run.ts",
    "insights:batch": "tsx src/jobs/insights/batch.ts",
    "insights:batch:dry": "DRY_RUN_LIMIT=50 tsx src/jobs/insights/batch.ts",
    "topics:seed": "tsx src/db/seeds/topics.ts"
  },
  "dependencies": {
    "@google-cloud/vertexai": "^1.10.0",
    "@google/genai": "^1.46.0",
    "@hono/node-server": "^1.19.11",
    "drizzle-orm": "^0.45.1",
    "firebase-admin": "^13.7.0",
    "groq-sdk": "^1.1.1",
    "hono": "^4.12.8",
    "postgres": "^3.4.8",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "dotenv": "^17.3.1",
    "drizzle-kit": "^0.31.9",
    "tsx": "^4.21.0",
    "typescript": "^5.8.3",
    "vitest": "^5.1.0"
  }
}
