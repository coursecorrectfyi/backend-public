# Copy to .env and fill in. Never commit .env.
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/coursecorrect
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
JWT_SECRET=YOUR_JWT_SECRET_HERE
ALLOWED_ORIGINS=http://localhost:3001

# Nothing sits in front of the API locally: use the connection's address as the client.
# (Production on Cloud Run uses 1; see docs/deployment-gcp.md §6.)
TRUST_PROXY_HOPS=0

# Optional, when running the frontend's Next.js server against this API locally: the
# secret it sends in X-Relay-Secret (at least 32 characters; any value works locally).
# TRUSTED_RELAY_SECRETS=local-development-relay-secret-0123456789

# Optional abuse-limit settings (defaults match production except RATE_LIMIT_MODE, which
# defaults to enforce; see README "Configuration").
# RATE_LIMIT_MODE=shadow
# CHAT_MODE=on

# Only needed for the AI insights job (INSIGHTS_PROVIDER=groq|gemini)
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
